# Local SQLite database (created by `npm run db:init`)
DATABASE_PATH=./data/deputeti.db

# Secret used for session cookie hardening in production deployments
SESSION_SECRET=change-me-to-a-long-random-string

# Upstream law API (eu-law FastAPI) — used only on the server
API_BASE_URL=https://eu-law.deputeti.ai
NEXT_PUBLIC_API_URL=https://eu-law.deputeti.ai
NEXT_PUBLIC_CHAT_MODEL=eu-law-rag
UPSTREAM_API_USERNAME=
UPSTREAM_API_PASSWORD=
